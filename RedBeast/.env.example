# BlinkSpace yapılandırma örneği. Hiçbiri zorunlu değildir; değerler varsayılanlardır.
# Gözlem arşivleri herkese açıktır. Yalnızca isteğe bağlı QFIT AI için anahtar gerekir.
# Gerçek .env dosyasını depoya koymayın; macOS başlatıcısı bu dosyayı okur.

# Kalıcı veri klasörü (SQLite + ham cutout'lar + hazırlanmış diziler)
BLINKSPACE_DATA_DIR=./data
# Derlenmiş arayüz (frontend/dist)
BLINKSPACE_FRONTEND_DIST=./frontend/dist

# Arşiv servisleri
BLINKSPACE_TAP_URL=https://irsa.ipac.caltech.edu/TAP
BLINKSPACE_IRSA_BASE=https://irsa.ipac.caltech.edu/
BLINKSPACE_SIMBAD_TAP_URL=https://simbad.harvard.edu/simbad/sim-tap

# Sınırlar (gerekçe: reports/performance.md)
BLINKSPACE_MIN_FOV_ARCMIN=2
BLINKSPACE_MAX_FOV_ARCMIN=30
BLINKSPACE_DEFAULT_FOV_ARCMIN=6
BLINKSPACE_MAX_FRAMES=16
BLINKSPACE_DEFAULT_FRAMES=8
BLINKSPACE_DOWNLOAD_CONCURRENCY=3

# Zaman aşımları (saniye) ve yeniden deneme
BLINKSPACE_HTTP_TIMEOUT_S=120
BLINKSPACE_TAP_TIMEOUT_S=240
BLINKSPACE_JOB_TIMEOUT_S=900
BLINKSPACE_MAX_RETRIES=3

# Arşiv sorgu önbelleği (saat). Yeni veri haftalık geldiği için 24 saat yeterlidir.
BLINKSPACE_TAP_CACHE_HOURS=24

# Archive transport: auto tries TAP and falls back to the official SIA service.
# Set sia explicitly if IRSA TAP is unavailable.
# BLINKSPACE_ARCHIVE_PROTOCOL=sia
# Same Gaia DR3 fields from ESA's primary archive (esa) or the official VizieR Harvard mirror
# of I/355/gaiadr3 (vizier) when the IRSA mirror is unavailable.
# BLINKSPACE_GAIA_PROVIDER=esa
# Official VizieR catalogue mirror for AllWISE when the IRSA catalogue service is unavailable.
# BLINKSPACE_ALLWISE_PROVIDER=vizier

# Optional assistant: off (default), mock (local test), qfit (OpenAI).
# Copy this file to .env; keep the key only on the server.
# QFIT retains the supplied OpenAI gpt-5.4-mini / reasoning none configuration.
# BLINKSPACE_ASSISTANT_PROVIDER=off
# BLINKSPACE_ASSISTANT_PROVIDER=mock
# BLINKSPACE_ASSISTANT_PROVIDER=qfit
# OPENAI_API_KEY=
# BLINKSPACE_ASSISTANT_DAILY_LIMIT=100
# QFIT_MAX_OUTPUT_TOKENS=1200
# QFIT_TIMEOUT_SECONDS=60
