  "components": {
    "schemas": {
      "ChatInput": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4000,
            "title": "Message",
            "default": ""
          },
          "context": {
            "additionalProperties": true,
            "type": "object",
            "title": "Context"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryMessage"
            },
            "type": "array",
            "maxItems": 10,
            "title": "History"
          },
          "tool_results": {
            "items": {
              "$ref": "#/components/schemas/ToolResult"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Tool Results"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ChatInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "HistoryMessage"
      },
      "MarkIn": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_\\-]+$",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "point",
              "region"
            ],
            "title": "Kind",
            "default": "point"
          },
          "classification": {
