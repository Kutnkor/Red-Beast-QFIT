# Copy to .env and fill in. Never commit .env. Production values: docs/DEPLOYMENT.md

# --- AI ---
# openai: OpenAI API (key from platform.openai.com with billing enabled; ChatGPT plans do not include API use)
# gemini / ollama: alternative providers, kept for reference
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# "none" = no reasoning step: fastest; supported values depend on the model
OPENAI_REASONING_EFFORT=none
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# When the model cannot answer (no key, no credit, daily budget, slow archive), /chat answers with a
# cited knowledge-base passage instead of an error.
AI_FALLBACK_ENABLED=true
CHAT_TIMEOUT_SECONDS=90

# --- Data sources ---
SPHEREX_BASE_URL=https://irsa.ipac.caltech.edu
HORIZONS_API_URL=https://ssd.jpl.nasa.gov/api/horizons.api

# --- Server ---
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
# Comma-separated list of allowed front-end origins (the Vite dev server is 5173)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# true only behind a reverse proxy / hosting platform (client IP from X-Forwarded-For)
TRUST_PROXY_HEADERS=false
# runtime data (candidate log); use a persistent disk in production
QFIT_DATA_DIR=data

# --- Limits and protection ---
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=2
CACHE_TTL_SECONDS=600
MAX_REQUEST_BODY_BYTES=65536
CHAT_RATE_LIMIT_PER_MINUTE=20
# model calls per UTC day for the whole site (0 = no limit); afterwards answers come from the knowledge base
CHAT_DAILY_LIMIT=500
# when set, candidate create/review/validate/confirm need header X-QFit-Token with this value
QFIT_TEAM_TOKEN=
