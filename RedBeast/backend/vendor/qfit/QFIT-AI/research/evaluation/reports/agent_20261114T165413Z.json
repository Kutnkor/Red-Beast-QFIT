      "must_mention": true,
      "source_grounding": true
     },
     "unsupported_numbers": [],
     "tools_called": [],
     "answer": "SPHEREx is a NASA Astrophysics all-sky survey telescope that observes in near-infrared light from 0.75 to 5.0 micron, according to Caltech/IPAC’s SPHEREx mission overview. It stands for Spectro-Photometer for the History of the Universe, Epoch of Reionization, and Ices Explorer.",
     "timings": [
      {
       "step": 0,
       "kind": "model",
       "ms": 1860,
       "tool_calls": []
      }
     ],
     "latency_s": 1.875
