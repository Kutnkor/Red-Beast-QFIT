      "must_mention": true,
      "source_grounding": true
     },
     "unsupported_numbers": [],
     "tools_called": [],
     "answer": "SPHEREx is a NASA astrophysics all-sky survey mission, according to Caltech’s SPHEREx mission overview. It stands for Spectro-Photometer for the History of the Universe, Epoch of Reionization, and Ices Explorer, and it observes in near-infrared light from 0.75 to 5.0 micron.",
     "timings": [
      {
       "step": 0,
       "kind": "model",
       "ms": 2797,
       "tool_calls": []
      }
     ],
     "latency_s": 2.812
    },
    {
     "id": "c-moving-target-tr",
